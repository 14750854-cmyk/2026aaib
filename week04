        "// week04-2 好玩的程式設計 for for 迴圈 + if 判斷\n",
        "// Ctrl-N 開新的程式視窗\n",
        "\n",
        "void setup() {\n",
        "  size(600, 400); // 視窗大小\n",
        "}\n",
        "\n",
        "void draw() {\n",
        "  for (int y = 0; y < 400; y += 50) {\n",
        "    for (int x = 0; x < 600; x += 50) {\n",
        "      if (x < mouseX && mouseX < x + 50)\n",
        "        fill(#74FFE4);\n",
        "      else if (y < mouseY && mouseY < y + 50)\n",
        "        fill(#74FFE4);\n",
        "      else\n",
        "        fill(#FFFFF2); // 自己在 Tool-色彩選擇器找色彩\n",
        "       rect(x, y, 50, 50);\n",
        "    }\n",
        "  }\n",
        "}"
